datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String                 @map("password_hash")
  createdAt             DateTime               @default(now()) @map("created_at")
  watchlists            Watchlist[]
  userSymbolStates      UserSymbolState[]
  changeAcknowledgments ChangeAcknowledgment[]

  @@map("users")
}

model Watchlist {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  name      String
  createdAt DateTime        @default(now()) @map("created_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]

  @@map("watchlists")
}

model WatchlistItem {
  id          String    @id @default(uuid())
  watchlistId String    @map("watchlist_id")
  symbol      String
  addedAt     DateTime  @default(now()) @map("added_at")
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@map("watchlist_items")
}

model Instrument {
  symbol   String @id
  name     String
  exchange String
  sector   String

  @@map("instruments")
}

model PriceTick {
  id         String   @id @default(uuid())
  symbol     String
  price      Float
  volume     Float
  exchangeTs DateTime @map("exchange_ts")
  ingestedAt DateTime @default(now()) @map("ingested_at")
  source     String

  @@index([symbol, exchangeTs])
  @@map("price_ticks")
}

model ChangeEvent {
  id                    String                 @id @default(uuid())
  symbol                String
  ts                    DateTime
  tier                  String
  score                 Float
  narrative             String
  signals               Json
  confidence            String                 @default("medium")
  createdAt             DateTime               @default(now()) @map("created_at")
  changeAcknowledgments ChangeAcknowledgment[]

  @@index([symbol, ts])
  @@map("change_events")
}

model UserSymbolState {
  userId          String   @map("user_id")
  symbol          String
  lastViewedAt    DateTime @map("last_viewed_at")
  lastViewedPrice Float    @map("last_viewed_price")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, symbol])
  @@map("user_symbol_state")
}

model ChangeAcknowledgment {
  userId        String      @map("user_id")
  changeEventId String      @map("change_event_id")
  status        String // 'seen' | 'acknowledged'
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  changeEvent   ChangeEvent @relation(fields: [changeEventId], references: [id], onDelete: Cascade)

  @@id([userId, changeEventId])
  @@map("change_acknowledgments")
}
